{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "name": "Dev: Backend",
      "request": "launch",
      "command": "npm run dev --workspace=backend",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "name": "Dev: Frontend",
      "request": "launch",
      "command": "npm run dev --workspace=frontend",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Dev: Full Stack",
      "configurations": ["Dev: Backend", "Dev: Frontend"],
      "stopAll": true
    }
  ]
}