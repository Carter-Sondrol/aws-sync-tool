{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug AWS Graph CLI",
            "type": "debugpy",
            "request": "launch",
            "module": "cli.cli",
            "args": [
                "--profile",
                "SafeRideHealth",
                "--region", 
                "us-west-2",
                "build",
                "--seed-csv",
                "./seeds.csv",
                "--seed-env",
                "dev",
                "--output",
                "./graph.json",
                "--deep"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Visualize Graph",
            "type": "debugpy",
            "request": "launch",
            "module": "cli.cli",
            "args": [
                "--profile",
                "SafeRideHealth",
                "--region",
                "us-west-2",
                "display",
                "--file",
                "./graph.json",
                "--visual",
                "--out",
                "./graph.html"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Generate CDK",
            "type": "debugpy",
            "request": "launch",
            "module": "cli.cli",
            "args": [
                "--profile",
                "SafeRideHealth",
                "--region",
                "us-west-2",
                "generate",
                "--graph",
                "./graph.json",
                "--output",
                "./cdk-out",
                "--stack-name",
                "GraphStack"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
